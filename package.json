{
  "name": "agent_conf",
  "version": "0.1.0",
  "private": true,
  "description": "Local one-click configurator for OpenAI-compatible agent tools.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check electron/main.js",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac dir --arm64 -c.mac.identity=null",
    "pack:mac:signed": "electron-builder --mac dir --arm64",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac zip --arm64 -c.mac.identity=null --publish never",
    "dist:mac:dmg": "electron-builder --mac dmg zip --arm64 -c.mac.identity=null --publish never",
    "dist:mac:signed": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.agentconf.desktop",
    "productName": "agent_conf",
    "asar": true,
    "files": [
      "assets/**/*",
      "config/**/*",
      "public/**/*",
      "dmapi-auth-service.cjs",
      "electron/**/*",
      "server.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/app-icon-mac.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
